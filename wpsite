        cmd_shell "$ARG1"
        ;;
    infra|base|i)
        cmd_infra "$ARG1" "$ARG2"
        ;;
    dns)
        cmd_dns "$ARG1" "$ARG2"
        ;;
    help|h|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        show_help
        exit 1
        ;;
esac